{
  "name": "strike-zone",
  "version": "1.2.0",
  "private": true,
  "description": "STRIKE ZONE: tactical 3D shooter for Android and web",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node tests/unit.mjs",
    "test:e2e": "node build.mjs && node tests/e2e.mjs all",
    "icons": "node tools/make-icons.mjs",
    "apk": "./tools/build-apk.sh",
    "lan": "./tools/build-lan.sh && java -jar dist/strikezone-lan.jar www",
    "test:lan": "./tools/build-lan.sh && node tests/lan.mjs && node tests/lan-e2e.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
